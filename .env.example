# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. In Vercel it is Neon's pooled URL. Locally it is the Docker
# database from `npm run db:up`: postgresql://postgres:postgres@localhost:5432/bftm_dev (ADR 0005).
DATABASE_URL=
# Direct (unpooled) connection, used for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Tests only (`npm test`): the database the tests migrate and truncate. Defaults to
# postgresql://postgres:postgres@localhost:5432/bftm_test; in CI, DATABASE_URL is used instead.
# Tests refuse to run against a neon.tech host.
TEST_DATABASE_URL=

# Vercel only: "true" lets `vercel-build` run migrations. Set it for Production,
# and for Preview only when previews have their own database branch.
RUN_MIGRATIONS=
